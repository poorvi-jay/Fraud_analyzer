# Database. Defaults to local SQLite if unset. Point this at a Supabase
# Postgres connection string (see supabase/schema.sql) for a real deployment.
#DATABASE_URL=sqlite:///./fraud_analyzer.db

# Context agent LLM provider: "mock" | "openai" | "anthropic".
#
# "mock" (default) needs no API key and uses a deterministic heuristic, so
# the pipeline runs end-to-end without credentials. Set "openai" with
# OPENAI_API_KEY for real LLM reasoning.
#
# These keys are SERVER-SIDE ONLY. Nothing here reaches the browser -- the
# frontend is built from VITE_* vars only (frontend/.env.example), and no
# route returns a key. Never add an LLM key to the frontend env.
#
# A misconfigured provider (missing/invalid key, unknown model) now fails
# loudly with HTTP 503 rather than silently serving mock verdicts.
LLM_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Must appear in MODEL_PRICING in backend/app/llm_usage.py, or requests are
# refused -- the cost guards can't price an unknown model. No date suffix:
# "gpt-5.6-luna", not "gpt-5.6-luna-20260730".
LLM_MODEL=gpt-5.6-luna

# Hard spend caps for THIS project, in USD, persisted in the llm_daily_spend
# table so they survive restarts (UTC days/months). Set these even if you
# also set a limit in the OpenAI console: that limit is org-wide, so it
# can't stop one project draining a key shared with others. When a cap is
# hit, the context agent serves the mock heuristic, labelled as such.
# Defaults assume a $5/month key split across four projects.
LLM_MONTHLY_BUDGET_USD=1.25
LLM_DAILY_BUDGET_USD=0.15

# Anomaly agent decision threshold (score >= this is "high" anomaly).
# Tuned from ml/reports/baseline_comparison.md; override if you retrain.
ANOMALY_HIGH_THRESHOLD=0.5

# Rate limit on the public POST /transactions/review endpoint.
REVIEW_RATE_LIMIT=20/minute

# CORS origin for the frontend during local dev.
FRONTEND_ORIGIN=http://localhost:5173

# Phase 2: reviewer auth on POST /reviews/{id}/override. The backend verifies
# reviewer session tokens against Supabase's Auth API, so it needs the same
# project URL and anon key the frontend uses to sign reviewers in.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Razorpay test-mode API keys. Used by scripts/verify_razorpay_schema.py ONLY
# -- the backend itself never calls Razorpay's API, it only parses Payment
# objects you POST to it, so leaving these empty changes nothing about how the
# app runs. The script refuses live (rzp_live_) keys by design.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
